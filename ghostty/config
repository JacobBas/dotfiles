# Ghostty Configuration converted from WezTerm

# Color scheme follows the macOS light/dark appearance.
theme = light:gruvbox_material_light,dark:gruvbox_material_dark

# Font configuration
font-family = "Monaspace Neon"
font-size = 11
# Increase stroke weight for better readability.
font-thicken = true
font-thicken-strength = 110

# Keybindings
# General stuff

# Tab management
keybind = super+shift+t=new_tab
keybind = super+shift+right=next_tab
keybind = super+shift+left=previous_tab

# Split configurations
keybind = ctrl+shift+v=new_split:right
keybind = ctrl+shift+h=new_split:down
